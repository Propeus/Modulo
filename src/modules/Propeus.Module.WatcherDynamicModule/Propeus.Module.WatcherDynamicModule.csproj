<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFrameworks>net8.0</TargetFrameworks>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
	</PropertyGroup>
	<PropertyGroup>
		<Product>Propeus.Module.WatcherDynamicModule</Product>
		<AssemblyName>Propeus.Module.WatcherDynamicModule</AssemblyName>
		<RootNamespace>Propeus.Module.WatcherDynamicModule</RootNamespace>
		<GenerateDocumentationFile>true</GenerateDocumentationFile>
		<IncludeSymbols>true</IncludeSymbols>
	</PropertyGroup>
	<PropertyGroup>
		<VersionPrefix>0.1.0</VersionPrefix>
		<Description>Componente para comunicação entre modulos de mesma instancia</Description>
		<Authors>Propeus</Authors>
		<Company>Propeus</Company>
	</PropertyGroup>
	<PropertyGroup>
		<RepositoryType>GIT</RepositoryType>
		<RepositoryUrl>https://github.com/Propeus/Modulo</RepositoryUrl>
	</PropertyGroup>
	<PropertyGroup>
		<PackageProjectUrl>https://github.com/Propeus/Modulo</PackageProjectUrl>
		<PackageTags>Propeus Net Modulo Dinamico</PackageTags>
		<PackageId>Propeus.Module.WatcherDynamicModule</PackageId>
		<PackageLicenseFile>LICENSE</PackageLicenseFile>
		<PackageRequireLicenseAcceptance>True</PackageRequireLicenseAcceptance>
		<SymbolPackageFormat>snupkg</SymbolPackageFormat>
		<EmbedUntrackedSources>true</EmbedUntrackedSources>
	</PropertyGroup>
	<ItemGroup>
	  <ProjectReference Include="..\..\addons\Propeus.Module.MessageQueue\Propeus.Module.MessageQueue.csproj" />
	  <ProjectReference Include="..\..\core\Propeus.Module.Abstract\Propeus.Module.Abstract.csproj" />
	  <ProjectReference Include="..\..\core\Propeus.Module.IL.Core\Propeus.Module.IL.Core.csproj" />
	</ItemGroup>

</Project>

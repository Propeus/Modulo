<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFrameworks>net8.0</TargetFrameworks>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
	</PropertyGroup>
	<PropertyGroup>
		<Product>Propeus.Module.MessageQueue</Product>
		<AssemblyName>Propeus.Module.MessageQueue</AssemblyName>
		<RootNamespace>Propeus.Module.MessageQueue</RootNamespace>
		<GenerateDocumentationFile>true</GenerateDocumentationFile>
		<IncludeSymbols>true</IncludeSymbols>
	</PropertyGroup>
	<PropertyGroup>
		<VersionPrefix>0.1.0</VersionPrefix>
		<Description>Componente para mapeamento de modulos em tempo de execução</Description>
		<Authors>Propeus</Authors>
		<Company>Propeus</Company>
	</PropertyGroup>
	<PropertyGroup>
		<RepositoryType>GIT</RepositoryType>
		<RepositoryUrl>https://github.com/Propeus/Modulo</RepositoryUrl>
	</PropertyGroup>
	<PropertyGroup>
		<PackageProjectUrl>https://github.com/Propeus/Modulo</PackageProjectUrl>
		<PackageTags>Propeus Net Modulo Mensageria</PackageTags>
		<PackageId>Propeus.Module.MessageQueue</PackageId>
		<PackageLicenseFile>LICENSE</PackageLicenseFile>
		<PackageRequireLicenseAcceptance>True</PackageRequireLicenseAcceptance>
		<SymbolPackageFormat>snupkg</SymbolPackageFormat>
		<EmbedUntrackedSources>true</EmbedUntrackedSources>
	</PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\core\Propeus.Module.Abstract\Propeus.Module.Abstract.csproj" />
  </ItemGroup>

</Project>
